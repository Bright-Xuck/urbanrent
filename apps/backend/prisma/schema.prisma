// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
}

enum AccountState {
  ACTIVE
  SUSPENDED
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  STUDIO
  HOUSE
  VILLA
  COMMERCIAL
  OTHER
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ViewingRequestStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  COMPLETED
  NO_SHOW
}

enum VerificationDocumentType {
  NATIONAL_ID
  PROOF_OF_OWNERSHIP
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyReportReason {
  SCAM_OR_FRAUD
  MISLEADING_INFORMATION
  ALREADY_RENTED
  OTHER
}

enum PropertyReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// ============================================================
// Models
// ============================================================

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  passwordHash      String
  role              Role
  verificationState VerificationState @default(UNVERIFIED)
  accountState      AccountState      @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sessions              Session[]
  properties            Property[]
  applications          Application[]
  viewingRequests       ViewingRequest[]
  verificationDocuments VerificationDocument[]
  reportsMade           PropertyReport[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  device    String?
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid

  // Core listing info
  title        String
  description  String?
  propertyType PropertyType @map("property_type")
  bedrooms     Int?
  bathrooms    Int?
  sizeSqm      Int?         @map("size_sqm")

  // Location
  city         String
  neighborhood String?
  address      String?
  latitude     Float?
  longitude    Float?

  // Pricing
  monthlyRent Int  @map("monthly_rent")
  cautionFee  Int? @map("caution_fee")

  // Status
  status PropertyStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  propertyAmenities PropertyAmenity[]
  images           PropertyImage[]
  applications     Application[]
  viewingRequests  ViewingRequest[]
  reports          PropertyReport[]

  @@index([ownerId])
  @@map("properties")
}

// ============================================================
// Amenity - a reusable catalog of property features
// ============================================================
// An amenity is a shared entity (e.g. "WiFi", "Parking", "Pool").
// It exists independently so it can be linked to many properties.
// ============================================================
model Amenity {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @unique
  picture String?

  propertyAmenities PropertyAmenity[]

  @@map("amenities")
}

// ============================================================
// PropertyAmenity - linking table (many-to-many)
// ============================================================
// Links a Property to an Amenity. This is a join table for the
// many-to-many relationship: one property has many amenities,
// and one amenity belongs to many properties.
//
// The @@unique([propertyId, amenityId]) prevents the same amenity
// from being added to the same property twice.
// ============================================================
model PropertyAmenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
  @@map("property_amenities")
}

// ============================================================
// PropertyImage - images belonging to a property
// ============================================================
// Each property can have multiple images. This model stores the
// image URL plus the Cloudinary public id (so we can delete the
// image from Cloudinary later when needed).
//
// onDelete: Cascade means deleting a property removes all its images.
// ============================================================
model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  url        String
  publicId   String   @map("public_id")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

// ============================================================
// Application - a tenant applies to rent a property
// ============================================================
// A tenant submits an application against a property. The lifecycle is
// driven by the ApplicationStatus state machine:
//
//   SUBMITTED → UNDER_REVIEW → APPROVED | REJECTED
//   SUBMITTED → APPROVED | REJECTED          (landlord can skip review)
//   SUBMITTED → WITHDRAWN                     (tenant withdraws)
//   UNDER_REVIEW → WITHDRAWN                  (tenant withdraws)
//
// NOTE: We intentionally do NOT put a @@unique([tenantId, propertyId])
// constraint here. That would block a tenant from ever reapplying after
// a REJECTED/WITHDRAWN application. Instead, "one ACTIVE application
// per tenant per property" is enforced in the SERVICE layer (a tenant
// can't have two SUBMITTED/UNDER_REVIEW applications on the same
// property, but CAN reapply once an earlier one is terminal).
// ============================================================
model Application {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  propertyId String            @db.Uuid
  status     ApplicationStatus @default(SUBMITTED)
  note       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([tenantId, propertyId])
  @@map("applications")
}

// ============================================================
// ViewingRequest - a tenant requests a viewing, landlord confirms
// ============================================================
// Dynamic request/confirm model: the tenant proposes one or more
// times (stored as a JSON array), and the landlord confirms one,
// declines, or marks a confirmed viewing as completed/no-show.
//
// Lifecycle:
//   REQUESTED → CONFIRMED | DECLINED        (landlord/admin)
//   CONFIRMED → COMPLETED | NO_SHOW         (landlord/admin)
//
// NOTE on concurrency: confirming a time rejects times that overlap
// any already-CONFIRMED viewing on ANY property owned by the same
// landlord (a landlord can't be in two viewings at once). The check
// runs inside a transaction with a pessimistic row lock (SELECT ...
// FOR UPDATE on the landlord's row) to avoid a TOCTOU race —
// implemented in viewingRequestService.ts.
// ============================================================
model ViewingRequest {
  id            String                @id @default(uuid()) @db.Uuid
  propertyId    String                @db.Uuid
  tenantId      String                @db.Uuid
  status        ViewingRequestStatus  @default(REQUESTED)
  proposedTimes Json?                 @map("proposed_times")
  confirmedTime DateTime?             @map("confirmed_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@map("viewing_requests")
}

// ============================================================
// VerificationDocument - ID / proof-of-ownership uploads
// ============================================================
// Landlord verification is upload-based: a landlord uploads proof
// (national ID, proof of ownership), and an admin reviews EACH
// document. Every document carries its own review state
// (PENDING → APPROVED | REJECTED) that is independent of the
// user's aggregate User.verificationState — the service layer
// flips VerificationState to VERIFIED once the required documents
// for that user are approved (and can set it back to UNVERIFIED if
// all approved docs are later revoked/replaced).
//
// Multiple documents per user are allowed (re-upload after a
// REJECTED review), so no unique constraint on userId.
//
// storagePath mirrors PropertyImage.publicId: it holds the
// Supabase Storage object path so the file can be deleted from
// storage later; url is the publicly readable/fetchable URL.
//
// NOTE: the schema does not restrict uploads to LANDLORDs — that
// role check belongs in the service/RBAC layer, not the DB.
// ============================================================
model VerificationDocument {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @db.Uuid
  url          String?
  storagePath  String                     @map("storage_path")
  documentType VerificationDocumentType   @map("document_type")
  status       VerificationDocumentStatus @default(PENDING)
  reviewNote   String?                    @map("review_note")
  createdAt    DateTime                   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("verification_documents")
}

// ============================================================
// PropertyReport - a tenant reports a suspicious/bad listing
// ============================================================
// Tenant-facing fraud reporting: any logged-in tenant can flag a
// listing (scam, misleading info, already rented, other), which
// lands in an admin review queue. Lifecycle:
//
//   OPEN → REVIEWED   (admin acted on the report, e.g. unpublished
//                      or archived the listing)
//   OPEN → DISMISSED  (admin checked it, listing is fine)
//
// NOTE: we intentionally do NOT put a @@unique([reporterId,
// propertyId]) constraint here — same reasoning as Application:
// it would block a tenant from ever re-reporting a property whose
// earlier report was DISMISSED (e.g. a scam listing gets
// re-published after being taken down). Instead, "one OPEN report
// per reporter per property" is enforced in the SERVICE layer.
//
// Reports reference (and cascade from) Property rather than being
// tied to User account state: admin's "delete" of a listing is a
// soft-delete via ARCHIVED, not a hard row delete, so reports are
// not destroyed by moderation actions.
// ============================================================
model PropertyReport {
  id         String               @id @default(uuid()) @db.Uuid
  reporterId String               @db.Uuid
  propertyId String               @db.Uuid
  reason     PropertyReportReason
  status     PropertyReportStatus @default(OPEN)
  createdAt  DateTime             @default(now()) @map("created_at")

  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([propertyId])
  @@index([status])
  @@map("property_reports")
}