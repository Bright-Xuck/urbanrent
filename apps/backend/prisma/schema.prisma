// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
}

enum AccountState {
  ACTIVE
  SUSPENDED
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  STUDIO
  HOUSE
  VILLA
  COMMERCIAL
  OTHER
}

// ============================================================
// Models
// ============================================================

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  passwordHash      String
  role              Role
  verificationState VerificationState @default(UNVERIFIED)
  accountState      AccountState      @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sessions   Session[]
  properties Property[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  device    String?
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid

  // Core listing info
  title        String
  description  String?
  propertyType PropertyType @map("property_type")
  bedrooms     Int?
  bathrooms    Int?
  sizeSqm      Int?         @map("size_sqm")

  // Location
  city         String
  neighborhood String?
  address      String?
  latitude     Float?
  longitude    Float?

  // Pricing
  monthlyRent Int  @map("monthly_rent")
  cautionFee  Int? @map("caution_fee")

  // Status
  status PropertyStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  propertyAmenities PropertyAmenity[]
  images           PropertyImage[]

  @@index([ownerId])
  @@map("properties")
}

// ============================================================
// Amenity - a reusable catalog of property features
// ============================================================
// An amenity is a shared entity (e.g. "WiFi", "Parking", "Pool").
// It exists independently so it can be linked to many properties.
// ============================================================
model Amenity {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @unique
  picture String?

  propertyAmenities PropertyAmenity[]

  @@map("amenities")
}

// ============================================================
// PropertyAmenity - linking table (many-to-many)
// ============================================================
// Links a Property to an Amenity. This is a join table for the
// many-to-many relationship: one property has many amenities,
// and one amenity belongs to many properties.
//
// The @@unique([propertyId, amenityId]) prevents the same amenity
// from being added to the same property twice.
// ============================================================
model PropertyAmenity {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
  @@map("property_amenities")
}

// ============================================================
// PropertyImage - images belonging to a property
// ============================================================
// Each property can have multiple images. This model stores the
// image URL plus the Cloudinary public id (so we can delete the
// image from Cloudinary later when needed).
//
// onDelete: Cascade means deleting a property removes all its images.
// ============================================================
model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  url        String
  publicId   String   @map("public_id")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}