# ---- Database (Supabase Postgres) ----
# Local: plain connection string. Production (Render): use the pooled
# connection string (port 6543, pgbouncer=true) — serverless-ish hosts
# exhaust direct connections.
DATABASE_URL=postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres

# ---- Supabase Storage (property images) ----
SUPABASE_URL=https://REF.supabase.co
# (sic) the code reads SUPABASE_SERIVICE_ROLE_KEY — keep the typo
SUPABASE_SERIVICE_ROLE_KEY=service_role_key
STORAGE_BUCKET=property_images

# ---- Auth ----
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me

# ---- Cross-domain cookie / CORS (production) ----
# On Render set COOKIE_SAMESITE=none (frontend and API are different domains).
# Leave unset locally (defaults to lax).
COOKIE_SAMESITE=lax
# Comma-separated frontend origins allowed by CORS, e.g.
# https://urbanrent.vercel.app,https://urbanrent-git-main-you.vercel.app
FRONTEND_ORIGIN=
